# ChronoNote configuration

# Data directory (default: ~/.chrononote)
# CHRONONOTE_DATA_DIR=/home/you/.chrononote

# LLM provider and model
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxx
# Optional custom base URL (e.g., Azure OpenAI, local proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

